# Copy this file to .env and adjust. Never commit .env.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://docs.example.com
# DJANGO_TIME_ZONE=Asia/Karachi

# --- Database (leave unset to use SQLite) ---------------------------------
# POSTGRES_DB=docucraft
# POSTGRES_USER=docucraft
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Files and processing -------------------------------------------------
DOCUCRAFT_MAX_UPLOAD_MB=25
DOCUCRAFT_RETENTION_DAYS=30
DOCUCRAFT_JOB_TIMEOUT=600
DOCUCRAFT_ASYNC_JOBS=True
# DOCUCRAFT_MEDIA_ROOT=/absolute/path/outside/the/project
# Set these only if the tools are installed somewhere unusual:
# LIBREOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
# TESSERACT_PATH=/opt/homebrew/bin/tesseract

# --- AI rewriting ---------------------------------------------------------
# ollama (local, private) | anthropic | openai | none
AI_PROVIDER=ollama
# Seconds the model may stay silent (loading or thinking) before a request fails.
AI_TIMEOUT=180
# Longest a single request may run in total, even while still writing.
AI_MAX_CALL_SECONDS=900
# Characters of document sent per request. Lower it on slower computers.
AI_CHUNK_CHARS=3000

OLLAMA_BASE_URL=http://localhost:11434
# Must match a name shown by: ollama list
OLLAMA_MODEL=qwen2.5:7b

# Cloud providers also require each user to tick "Allow cloud AI" in Settings.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
